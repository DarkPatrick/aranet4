[Unit]
Description=Collect Cyprus weather station data (feed updates every 10 minutes)

[Timer]
# each value stays in the feed for 10 minutes and is published a few minutes after
# its mark; polling every 5 minutes never misses one, and an unchanged feed is a 304
OnCalendar=*:0/5
OnBootSec=1min
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
