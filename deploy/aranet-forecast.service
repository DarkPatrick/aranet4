[Unit]
# wait for NTP: the Pi has no RTC battery and boots with a stale clock
After=time-sync.target
Wants=time-sync.target
Description=dom.org.cy forecast bulletins + translation (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/config.env
ExecStart=__DIR__/.venv/bin/aranet-forecast
TimeoutStartSec=600
