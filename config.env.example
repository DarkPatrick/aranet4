# Copy to config.env and fill in.
# Bluetooth address of the sensor: MAC on Linux (AA:BB:CC:DD:EE:FF),
# a CoreBluetooth UUID on macOS. Find it with: aranet-collect --scan
ARANET_ADDRESS=

# SQLite database file
ARANET_DB=data/aranet.db

# Cyprus weather stations database (aranet-weather)
ARANET_WEATHER_DB=data/weather.db

# Dashboard bind address / port
ARANET_HOST=0.0.0.0
ARANET_PORT=8080

# Optional: push a copy of the database to a server after every collection
# (rsync over ssh, e.g. aranet@example.com:aranet.db). Empty = no sync.
ARANET_SYNC_TARGET=
ARANET_SYNC_KEY=~/.ssh/id_ed25519_aranet_sync
