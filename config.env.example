# Copy to config.env and fill in.
# Bluetooth address of the sensor: MAC on Linux (AA:BB:CC:DD:EE:FF),
# a CoreBluetooth UUID on macOS. Find it with: aranet-collect --scan
ARANET_ADDRESS=

# SQLite database file
ARANET_DB=data/aranet.db

# Dashboard bind address / port
ARANET_HOST=0.0.0.0
ARANET_PORT=8080
